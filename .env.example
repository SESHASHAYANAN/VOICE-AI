# =============================================================================
# Business Voice AI - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values

# ---- Application ----
APP_NAME=BusinessVoiceAI
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# ---- Database ----
# SQLite (Zero-config local development):
DATABASE_URL=sqlite+aiosqlite:///./business_voice.db
DATABASE_SYNC_URL=sqlite:///./business_voice.db
# Or PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/business_voice_ai
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/business_voice_ai

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Auth ----
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM Engine (Groq / xAI) ----
# Groq API (High-speed NLU and function calling)
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# xAI Grok (Alternative LLM provider)
XAI_API_KEY=your-xai-api-key
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-latest

# ---- Bolna AI Voice Platform ----
BOLNA_API_KEY=your-bolna-api-key
BOLNA_API_BASE_URL=https://api.bolna.ai
BOLNA_WEBHOOK_SECRET=your-bolna-webhook-secret

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ---- Demo Mode ----
# Set to true to use simulated data when API keys are missing
DEMO_MODE=false
